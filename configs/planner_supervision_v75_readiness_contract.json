{
  "schema": "uruha_planner_supervision_readiness_contract_v75",
  "status": "frozen_before_auditor_execution",
  "frozen_on": "2026-07-18",
  "parent_commit": "1a1d4e26c75802069f76ac23eece3953327f3c7f",
  "ability_under_test": "leftbrain_cognitive_speech_planning",
  "hypothesis": "The repository contains no planner-supervision row that simultaneously preserves a raw user utterance and bounded cognitive context, supplies a complete target plan, has strict human acceptance of that plan, and remains outside protected evaluation data.",
  "falsification_condition": "At least one row passes every input, target, human-review, provenance, split-isolation, and overlap gate below.",
  "success_condition_for_this_unit": "The read-only auditor inventories every registered source with hashes, separates surface-form data from planner targets, detects protected evaluation data, and emits a reproducible training authorization decision without changing runtime behavior.",
  "stop_condition": "If fewer than 60 eligible rows exist or the pilot coverage grid is incomplete, do not fine-tune a planner and do not expand model testing. Build the smallest provenance-safe collection path instead.",
  "required_input_fields": [
    "user_utterance",
    "language",
    "recent_dialogue",
    "working_memory",
    "psyche_state",
    "relationship_state"
  ],
  "required_target_plan_fields": [
    "intent",
    "scene",
    "listener_state",
    "reply_goal",
    "jp_summary",
    "core_message_jp",
    "cognitive_mode",
    "response_mode",
    "premise_check",
    "uncertainty",
    "hidden_intent",
    "surface_act",
    "user_belief",
    "my_hidden_knowledge",
    "user_expectation",
    "working_memory_used",
    "routing_path",
    "bayes_candidates"
  ],
  "minimum_candidate_plan_count": 3,
  "strict_human_review": {
    "required_decision": "accept",
    "required_fields": [
      "reviewer_id",
      "reviewed_at",
      "target_plan_sha256"
    ],
    "surface_reply_ratings_do_not_count_as_plan_acceptance": true,
    "draft_or_batch_acceptance_is_not_strict_review": true
  },
  "required_provenance_fields": [
    "source_kind",
    "source_id",
    "source_sha256",
    "benchmark_origin"
  ],
  "required_benchmark_origin": "none",
  "sha256_pattern": "^[0-9a-f]{64}$",
  "training_split": "train",
  "languages": [
    "ja",
    "zh",
    "en"
  ],
  "scenario_families": [
    "ordinary_direct",
    "emotional_support",
    "ambiguity_clarification",
    "memory_recall_update",
    "false_belief_tom",
    "pragmatic_implicature",
    "boundary_safety",
    "action_function_call",
    "relationship_personality",
    "reflection_repair"
  ],
  "readiness_levels": {
    "not_ready": {
      "maximum_eligible_rows": 59,
      "authorization": "no_training"
    },
    "pilot_ready": {
      "minimum_eligible_rows": 60,
      "minimum_per_language_family_cell": 2,
      "authorization": "small_local_training_pilot_only"
    },
    "training_candidate": {
      "minimum_eligible_rows": 600,
      "minimum_per_language_family_cell": 20,
      "authorization": "formal_training_experiment_may_be_preregistered"
    }
  },
  "threshold_status": "project_defined_coverage_gates_not_official_sample_size_rules",
  "discovery_excluded_quarantine_prefixes": [
    "analysis/local_planner_supervision_v76/"
  ],
