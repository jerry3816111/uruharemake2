  "observation_unit": {
    "definition": "一段有明確可觀察情境、對象及行為結果的連續公開事件；不得為了增加樣本數把同一反應切成多筆。",
    "start_rule": "情境改變、對話對象改變或可觀察問題出現時開始。",
    "end_rule": "行為反應完成或話題明確切換時結束；不得只因時間長度而拆分同一反應。",
    "same_event_alias_forbidden": true,
    "overlapping_timestamp_records_forbidden": true,
    "fixed_duration_chunking_forbidden": true,
    "non_observation_is_not_negative_evidence": true,
    "private_motive_inference_forbidden": true
  },
  "record_contract": {
    "required_fields": [
      "event_id",
      "source_id",
      "source_partition_key",
      "timestamp_locator_start_seconds",
      "timestamp_locator_end_seconds",
      "context_family",
      "observable_context_paraphrase",
      "observable_behavior_paraphrase",
      "primary_dimension",
      "secondary_dimensions",
