      "observable_audience_relation",
      "evidence_strength",
      "ambiguity_notes",
      "alternative_interpretations",
      "coder_pseudonym",
      "reviewer_pseudonym",
      "review_status",
      "coding_protocol_version_hash"
    ],
    "allowed_evidence_strength": [
      "directly_observed",
      "context_supported",
      "ambiguous"
    ],
    "allowed_review_status": [
      "pending_independent_review",
      "accepted",
      "rejected",
      "needs_adjudication"
    ],
    "forbidden_payload_field_names": [
      "raw_text",
      "raw_media",
      "transcript",
      "verbatim_transcript",
      "quote_text",
      "target_reply",
      "expected_reply",
      "reference_answer",
      "answer_key",
      "model_output",
      "training_text"
    ],
    "researcher_paraphrase_only": true,
    "copied_quote_allowed": false,
    "target_wording_template_allowed": false
  },
  "coding_workflow": [
    {
      "stage": "primary_observation",
      "actor": "coder",
      "input": "authorized public calibration source and frozen schema only",
      "output": "observable context and behavior paraphrase with timestamp locator",
      "system_outputs_visible": false
    },
    {
      "stage": "independent_review",
      "actor": "reviewer_distinct_from_coder",
      "input": "source locator and coder record without system output",
      "output": "accept reject or adjudicate dimension evidence and ambiguity",
      "system_outputs_visible": false
    },
    {
      "stage": "agreement_and_adjudication",
      "actor": "research_process",
      "input": "independently coded records",
      "output": "agreement statistics and retained disagreements",
      "unfavorable_or_ambiguous_records_deleted_to_raise_score": false
    }
  ],
  "anti_leakage": {
    "event_records_may_enter_prompt": false,
    "event_records_may_enter_memory": false,
