{
  "schema": "uruha_p4_b_safe_isolated_product_launcher_contract_v1",
  "version": "1.0.0",
  "single_changed_variable": "add_safe_isolated_product_launcher",
  "entrypoint": "uruha_web_ui_product.py",
  "required_behavior": {
    "host_exact": "127.0.0.1",
    "port_min": 1024,
    "port_max": 65535,
    "python_resolution_order": [
      "explicit_cli",
      "URUHA_PRODUCT_PYTHON",
      "safe_worktree_bundled_venv",
      "sibling_original_checkout_existing_venv"
    ],
    "required_isolated_env": [
      "URUHA_MEMORY_DB_PATH",
      "URUHA_WEB_SESSION_DB_PATH",
      "URUHA_WEB_LOG_JSONL_PATH",
      "URUHA_WEB_LOG_TXT_PATH",
      "URUHA_WEB_HOST",
      "URUHA_WEB_PORT",
      "URUHA_SKIP_AUTO_VENV",
      "URUHA_IDLE_VISIBLE_PROACTIVE_ENABLED",
      "GRADIO_ANALYTICS_ENABLED"
    ],
    "preflight_imports_product_entry": true,
    "check_mode_starts_server": false,
    "check_mode_calls_model": false,
    "runtime_root_default": "new_private_os_temporary_directory",
    "existing_runtime_root_requires_launcher_manifest_and_explicit_reuse": true
  },
  "forbidden_behavior": {
    "public_bind": true,
    "gradio_share": true,
    "external_deployment": true,
    "login_or_cookie_use": true,
    "paid_api_use": true,
    "production_memory_default": true,
    "original_checkout_write": true,
    "brain_prompt_research_vrm_or_function_calling_change": true
  },
  "offline_acceptance": {
    "fixture_cases": [
      "explicit_python_precedes_environment_and_fallback",
      "missing_or_nonexecutable_python_fails_closed",
      "dependency_probe_failure_fails_closed",
      "invalid_port_fails_closed",
      "fresh_runtime_root_has_private_permissions_and_disjoint_paths",
      "unmarked_existing_root_fails_closed",
      "marked_root_requires_explicit_reuse",
      "child_environment_forces_localhost_isolation_and_idle_visible_guard",
      "check_mode_cleans_temporary_root_and_never_starts_product_server"
    ],
    "model_call_count": 0,
    "runtime_server_start_count": 0,
    "safari_operation_count": 0
  },
  "post_freeze_real_acceptance": {
    "allowed_after_commit": true,
    "required": [
      "server_listens_only_on_127_0_0_1",
      "health_page_responds",
      "actual_memory_session_and_log_paths_are_under_isolated_root",
      "chat_and_same_turn_graph_visible",
      "restart_can_reuse_only_explicit_preserved_launcher_root",
      "safari_visibility_is_reported_separately"
    ]
  },
  "claim_boundary": "A launcher pass establishes reproducible isolated startup only. It cannot establish VRM, Function Calling, conversation quality, research advantage, or formal readiness."
}
