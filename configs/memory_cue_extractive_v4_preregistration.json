    {
      "claim": "Recall depends on retrieval cues that match how an event was encoded.",
      "source": "Tulving and Thomson, Encoding Specificity and Retrieval Processes in Episodic Memory (1973)",
      "url": "https://doi.org/10.1037/h0020071"
    },
    {
      "claim": "Extractive compression can select useful source sentences and return no augmentation when evidence is irrelevant.",
      "source": "RECOMP, ICLR 2024",
      "url": "https://proceedings.iclr.cc/paper_files/paper/2024/hash/bda88ed2892f5e61c9a9bf215c566913-Abstract-Conference.html"
    },
    {
      "claim": "Retrieval should be triggered only when the current generation lacks required knowledge.",
      "source": "FLARE, EMNLP 2023",
      "url": "https://aclanthology.org/2023.emnlp-main.495/"
    },
    {
      "claim": "Remembering includes judgments about the source of information and those judgments can fail.",
      "source": "Johnson, Hashtroudi, and Lindsay, Source Monitoring (1993)",
      "url": "https://pubmed.ncbi.nlm.nih.gov/8346328/"
    }
  ],
  "hypothesis": {
    "primary": "When the normal evidence ledger is insufficient, answering from a small query-aligned set of exact user utterances will recover more answerable memories than rerunning the same extractor over highlighted full context.",
    "safety": "The same path must retain perfect abstention on truly unanswerable cases because only user-source utterances are eligible and uncertainty-only candidates are rejected.",
    "efficiency": "Direct extractive fallback should use less latency and fewer prompt tokens than model-based rereading plus ledger reconstruction."
  },
