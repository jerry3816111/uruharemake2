  "official_harness_compatibility": {
    "unchanged_official_prompt": true,
    "official_user_prompt_exact": true,
    "generic_json_only_system_transport_adapter": "Execute the user's role-identification task. Return only the final JSON object requested by the user. Do not output analysis, explanations, markdown, or code fences. Preserve every candidate name exactly. Use a finite probability from 0 to 1 for every candidate. Before returning, recalculate the total; if needed, set the final candidate to 1 minus the sum of the others so the probabilities total exactly 1.0.",
