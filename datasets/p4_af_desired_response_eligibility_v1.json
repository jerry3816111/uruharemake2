  "authority_contract": {
    "allowed": [
      "typed_cognitive_overactivity",
      "current_explicit_response_form",
      "bounded_emotional_or_support_signal",
      "matched_verified_trigger_relation"
    ],
    "forbidden_as_solo_authority": [
      "task_topic",
      "task_pressure_atom",
      "domain_label",
      "unverified_historical_preference"
    ],
    "candidate_ranking_change_allowed": false,
    "visible_reply_change_allowed": false
  },
  "claim_boundary": "This dataset tests whether a desired-response ambiguity ledger is causally authorized by current interaction evidence rather than a topic word. It does not test the truth of private desire, visible reply quality, human preference, or strong-LLM advantage."
