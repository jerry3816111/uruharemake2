      ],
      "turns": [
        {
          "turn_id": "p3-smoke-02-u1",
          "session_id": "p3-smoke-02-s1",
          "content": "A friend invited me to a crowded concert this weekend. I said maybe.",
          "content_sha256": "ef46d14a23b81d61a6e4286365be7596dcdeab3dc2448a602097c2cf1b1a0d28"
        },
        {
          "turn_id": "p3-smoke-02-u2",
          "session_id": "p3-smoke-02-s1",
          "content": "I don't hate the band; I just go quiet when there are too many people.",
          "content_sha256": "550dc48302c1e543fc91fae4241c379976e48f4e81a2dcf98553c825293ed768"
        },
        {
          "turn_id": "p3-smoke-02-u3",
          "session_id": "p3-smoke-02-s2",
          "content": "Actually, I texted them that I won't go this time.",
          "content_sha256": "1925984e5bfcc8a07f28f6e034c1291b7299b81377755c725d66e9979de96dc3"
        },
        {
          "turn_id": "p3-smoke-02-u4",
          "session_id": "p3-smoke-02-s2",
          "content": "Don't try to talk me back into it. Help me decline without making it sound personal.",
          "content_sha256": "07cd265f9372bf641b77382be59664a88d94c11b30a81dad12b54121528e8c74"
        }
      ]
    },
