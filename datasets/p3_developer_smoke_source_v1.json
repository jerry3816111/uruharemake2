        {
          "turn_id": "p3-smoke-05-u3",
          "session_id": "p3-smoke-05-s2",
          "content": "What kind of cups did I say I prefer?",
          "content_sha256": "631df724db666e4c3bcf88c42444eeb6f5784f8f88da1a0b79f6ab87bf42732a"
        },
        {
          "turn_id": "p3-smoke-05-u4",
          "session_id": "p3-smoke-05-s2",
          "content": "And the night market plan was Mina's, not mine—please keep that straight.",
          "content_sha256": "12dbb0b463156f05cd4dc3319470d832b240580f3e0b905048da1ef91ead06fc"
        }
      ]
